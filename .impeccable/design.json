      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action in view: navy with a top light.",
      "html": "<button class=\"ds-btn-primary\">Book a spot</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 14px;border:0;border-radius:var(--r-md,8px);background:var(--primary,#2c49b6);color:var(--on-primary,#fff);font:550 14px/1 'Schibsted Grotesk',Arial,sans-serif;letter-spacing:-0.006em;box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 1px 2px rgba(0,0,0,.25);cursor:pointer;transition:background-color 120ms cubic-bezier(.16,1,.3,1),transform 120ms}.ds-btn-primary:hover{background:var(--primary-hover,#3654c6)}.ds-btn-primary:active{transform:scale(.965)}.ds-btn-primary:focus-visible{outline:2px solid var(--tint,#8ea2f2);outline-offset:2px}"
    },
    {
      "name": "Gray Button",
      "kind": "button",
      "refersTo": "button-gray",
