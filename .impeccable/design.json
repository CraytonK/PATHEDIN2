      "css": ".ds-btn-gray{height:30px;padding:0 12px;border:0;border-radius:var(--r-md,8px);background:var(--fill,#1c1f25);color:var(--label,#eceef2);font:550 13px/1 'Schibsted Grotesk',Arial,sans-serif;box-shadow:inset 0 0 0 1px var(--separator,rgba(255,255,255,.075));cursor:pointer;transition:background-color 120ms}.ds-btn-gray:hover{background:var(--bg-press,rgba(255,255,255,.08))}.ds-btn-gray:focus-visible{outline:2px solid var(--tint,#8ea2f2);outline-offset:2px}"
    },
