      "css": ".ds-tag{display:inline-flex;align-items:center;height:30px;padding:0 12px;border-radius:999px;background:var(--fill-3,#15171b);box-shadow:inset 0 0 0 1px var(--separator,rgba(255,255,255,.075));color:var(--label-2,#9ba0ac);font:500 13px 'Schibsted Grotesk',Arial,sans-serif;cursor:pointer}.ds-tag:hover{box-shadow:inset 0 0 0 1px var(--border-strong,rgba(255,255,255,.16))}.ds-tag.is-on{background:var(--tint-soft,rgba(142,162,242,.16));box-shadow:inset 0 0 0 1px var(--tint-border,rgba(142,162,242,.34));color:var(--label,#eceef2)}"
    },
    {
      "name": "Panel Card",
