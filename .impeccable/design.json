      "html": "<article class=\"ds-card\"><strong>Aisha Bello</strong><p>Associate Scientist, R&amp;D at Alden Therapeutics</p></article>",
      "css": ".ds-card{width:260px;padding:18px;border-radius:var(--r-lg,12px);background:var(--bg-grouped,#111317);color:var(--label,#eceef2);font:400 13px/18px 'Schibsted Grotesk',Arial,sans-serif;box-shadow:0 0 0 1px rgba(255,255,255,.065),inset 0 1px 0 rgba(255,255,255,.035);transition:transform 300ms cubic-bezier(.16,1,.3,1),box-shadow 300ms}.ds-card strong{font-size:17px;line-height:22px;font-weight:600}.ds-card p{margin:4px 0 0;color:var(--label-2,#9ba0ac)}.ds-card:hover{transform:translateY(-2px);box-shadow:0 0 0 1px rgba(255,255,255,.1),0 8px 24px -10px rgba(0,0,0,.6)}"
    },
    {
      "name": "Sidebar Row",
      "kind": "nav",
      "refersTo": "sidebar-item",
      "description": "32px rows; the active row sits on a sliding selected surface.",
      "html": "<nav class=\"ds-nav\"><a class=\"is-active\">Home</a><a>My Path</a><a>Discover</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;width:220px;font:450 14px 'Schibsted Grotesk',Arial,sans-serif}.ds-nav a{height:32px;display:flex;align-items:center;padding:0 10px;border-radius:var(--r-sm,6px);color:var(--label-2,#9ba0ac);cursor:pointer;transition:color 120ms,background-color 120ms}.ds-nav a:hover{background:var(--bg-hover,rgba(255,255,255,.045));color:var(--label,#eceef2)}.ds-nav a.is-active{background:var(--bg-selected,rgba(255,255,255,.065));box-shadow:inset 0 0 0 1px var(--separator,rgba(255,255,255,.075));color:var(--label,#eceef2);font-weight:550}"
