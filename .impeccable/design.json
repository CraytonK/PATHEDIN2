      "html": "<div class=\"ds-band\"><i style=\"left:8%;width:28%\" class=\"lit\"></i><i style=\"left:36%;width:28%\"></i><i style=\"left:64%;width:28%\" class=\"fut\"></i><b style=\"left:8%\" class=\"lit\"></b><b style=\"left:36%\" class=\"lit\"></b><b style=\"left:64%\" class=\"now\"></b><b style=\"left:92%\" class=\"dest\"></b></div>",
      "css": ".ds-band{position:relative;width:280px;height:64px;border-radius:12px 12px 0 0;background:var(--bg-sunken,#08090b)}.ds-band i{position:absolute;top:22px;height:3px;margin-top:-1.5px;background:var(--label-4,#3a3e47)}.ds-band i.lit{background:var(--tint,#8ea2f2)}.ds-band i.fut{background:repeating-linear-gradient(90deg,var(--tint,#8ea2f2) 0 5px,transparent 5px 10px)}.ds-band b{position:absolute;top:22px;width:11px;height:11px;margin:-5.5px 0 0 -5.5px;border-radius:50%;background:var(--label-3,#6c717d);box-shadow:0 0 0 3px var(--bg-sunken,#08090b)}.ds-band b.lit{background:var(--tint,#8ea2f2)}.ds-band b.now{width:15px;height:15px;margin:-7.5px 0 0 -7.5px;background:radial-gradient(circle,var(--tint,#8ea2f2) 0 3px,var(--bg-sunken,#08090b) 3.6px);box-shadow:inset 0 0 0 2.5px var(--ink,#e4e7ec),0 0 0 3px var(--bg-sunken,#08090b)}.ds-band b.dest{width:14px;height:14px;margin:-7px 0 0 -7px;background:var(--bg-sunken,#08090b);box-shadow:inset 0 0 0 2px var(--tint,#8ea2f2),0 0 0 3px var(--bg-sunken,#08090b)}"
